# Copy to .env. Never commit real credentials.
DEEPSEEK_API_KEY=
KESTRI_MODEL=deepseek-flash
KESTRI_THINKING_MODE=disabled
KESTRI_MAX_MODEL_CALLS=8
KESTRI_MAX_TOOL_CALLS=8
KESTRI_RUN_TIMEOUT_SECONDS=120
KESTRI_REQUEST_TIMEOUT_SECONDS=30
KESTRI_MAX_OUTPUT_TOKENS=4096
KESTRI_EVIDENCE_DIR=.kestri/evidence

# M1: bot credentials and local persistence. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
TAVILY_API_KEY=
KESTRI_TELEGRAM_OWNER_ID=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://kestri:replace-with-local-db-password@127.0.0.1:55433/kestri
# URL verification resolver. cloudflare opts into public-hostname disclosure to its DoH API.
# Useful with fake-IP proxies; never permits private targets. No automatic fallback.
KESTRI_URL_DNS_MODE=system
KESTRI_INPUT_TOKEN_BUDGET=128000
KESTRI_MONTHLY_BUDGET_USD=20
KESTRI_RUN_BUDGET_USD=0.50

# M2: no implicit timezone. Set explicitly or include an IANA zone in each task request.
# KESTRI_OWNER_TIMEZONE=Asia/Shanghai
KESTRI_TASK_LIMIT=16
KESTRI_BACKGROUND_QUEUE_LIMIT=8
KESTRI_SCHEDULER_INTERVAL_SECONDS=5

# M3 memory and managed context defaults
KESTRI_MEMORY_LIMIT=64
KESTRI_MEMORY_CONTEXT_LIMIT=8
KESTRI_CONTEXT_TRIGGER_RATIO=0.70
KESTRI_CONTEXT_KEEP_MESSAGES=12
KESTRI_MAX_SUMMARY_CALLS=2
KESTRI_SUMMARY_MAX_CHARS=4000

# M4 retention runs at idle startup, then hourly; operator commands default to dry-run.
KESTRI_ARCHIVE_RETENTION_DAYS=90
KESTRI_EVIDENCE_RETENTION_DAYS=30
KESTRI_LOG_RETENTION_DAYS=30
KESTRI_BACKUP_RETENTION_DAYS=30
KESTRI_MAINTENANCE_INTERVAL_SECONDS=3600
