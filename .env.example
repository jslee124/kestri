# Copy to .env. Never commit real credentials.
DEEPSEEK_API_KEY=
KESTRI_MODEL=deepseek-flash
KESTRI_THINKING_MODE=disabled
KESTRI_MAX_MODEL_CALLS=4
KESTRI_MAX_TOOL_CALLS=4
KESTRI_RUN_TIMEOUT_SECONDS=60
KESTRI_REQUEST_TIMEOUT_SECONDS=20
KESTRI_MAX_OUTPUT_TOKENS=1024
KESTRI_EVIDENCE_DIR=.kestri/evidence
